<?xml version="1.0" encoding="utf-8"?>
<!-- One quick settings tile: icon on top, name and an optional status line at the bottom. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="78dp"
    android:layout_weight="1"
    android:layout_margin="5dp"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingEnd="12dp"
    android:paddingTop="13dp"
    android:paddingBottom="11dp"
    android:background="@drawable/quick_tile_bg"
    android:focusable="true"
    android:clickable="true">

    <ImageView
        android:id="@+id/icon"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:tint="@drawable/pill_text"
        android:duplicateParentState="true"
        android:contentDescription="@null" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@drawable/pill_text"
        android:duplicateParentState="true"
        android:textSize="14sp"
        android:fontFamily="@font/outfit_medium"
        android:includeFontPadding="false"
        android:singleLine="true"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:textColor="@drawable/pill_text_dim"
        android:duplicateParentState="true"
        android:textSize="11sp"
        android:fontFamily="@font/outfit"
        android:letterSpacing="0.02"
        android:includeFontPadding="false"
        android:singleLine="true"
        android:ellipsize="end"
        android:visibility="gone" />
</LinearLayout>
